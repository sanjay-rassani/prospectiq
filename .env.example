# Copy to .env and adjust. No paid credentials are required anywhere in this file.
# .env is gitignored; never commit real values.

ENV=dev
DEBUG=true

# Application bind address. Leave on loopback: there is no authentication yet.
HOST=127.0.0.1
PORT=8000

# Postgres. These match the defaults in docker-compose.yml.
POSTGRES_USER=prospectiq
POSTGRES_PASSWORD=prospectiq
POSTGRES_DB=prospectiq
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
TEST_POSTGRES_DB=prospectiq_test

# Local Ollama. Runs as a host service, not a container.
OLLAMA_URL=http://127.0.0.1:11434
EXTRACTION_MODEL=numind/nuextract3:q4_k_m
GENERATION_MODEL=qwen3.5:4b
LLM_NUM_CTX=8192
LLM_TIMEOUT_SECONDS=600
LLM_MAX_ATTEMPTS=3
LLM_MAX_INPUT_CHARS=12000
LLM_ENABLED=true

# Fetcher politeness
USER_AGENT=ProspectingEngine/0.1 (personal business research)
FETCH_TIMEOUT_SECONDS=30
PER_DOMAIN_DELAY_SECONDS=5
MAX_CONCURRENT_FETCHES=4

LOG_LEVEL=INFO
